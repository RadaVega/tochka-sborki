// prisma/schema.prisma — application data model

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProjectSubmission {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String
  email       String
  phone       String?
  stack       String[]
  description String
  deadline    String
  budget      String
  fileUrl     String?
  consent     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Server-side analytics event log.
// Matches the existing Supabase table: event/path/metadata/createdAt.

model AnalyticsEvent {
  id        String    @id @default(cuid())
  event     String
  path      String?
  metadata  String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)

  @@index([event, createdAt])
  @@index([createdAt])
}
