generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Existing models ───────────────────────────────

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  consent   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("createdAt")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  consent   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("createdAt")
}

model ProjectSubmission {
  id          Int      @id @default(autoincrement())
  companyName String   @map("companyName")
  contactName String   @map("contactName")
  email       String
  phone       String?
  stack       String[]
  description String
  deadline    String
  budget      String
  fileUrl     String?  @map("fileUrl")
  consent     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("createdAt")

  teamMatches TeamMatch[]
}

model AnalyticsEvent {
  id        String    @id @default(cuid())
  event     String
  path      String?
  metadata  String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6) @map("createdAt")

  @@index([event, createdAt])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════
// NEW: StudentProfile
// ════════════════════════════════════════════════════

model StudentProfile {
  id   Int    @id @default(autoincrement())

  name      String
  email     String  @unique
  telegram  String?
  phone     String?

  stack          String[]
  preferredStack String?  @map("preferredstack")
  experience     String

  skillScore     Float?   @map("skillscore")
  codeQuality    Float?   @map("codequality")
  docScore       Float?   @map("docscore")
  speedScore     Float?   @map("speedscore")

  portfolio      String?
  linkedIn       String?  @map("linkedin")
  resumeUrl      String?  @map("resumeurl")
  about          String

  availableFrom   DateTime? @map("availablefrom")
  maxHoursPerWeek Int       @default(20) @map("maxhoursperweek")
  completedProjects Int     @default(0) @map("completedprojects")
  totalEarned    Float      @default(0) @map("totalearned")

  status    StudentStatus @default(PENDING)

  consent        Boolean  @default(false)
  selfEmployed   Boolean  @default(false) @map("selfemployed")
  ndaSigned      Boolean  @default(false) @map("ndasigned")

  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")

  teamMatches TeamMatch[]

  @@index([status])
  @@index([experience])
  @@index([skillScore])
  @@index([availableFrom])
}

enum StudentStatus {
  PENDING
  SCORING
  ACTIVE
  MATCHED
  SUSPENDED
  REJECTED
}

// ════════════════════════════════════════════════════
// NEW: TeamMatch
// ════════════════════════════════════════════════════

model TeamMatch {
  id Int @id @default(autoincrement())

  studentId   Int
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  projectId   Int
  project     ProjectSubmission @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role        String?
  isMentor    Boolean           @default(false)

  matchScore  Float?
  stackFit    Float?
  teamFit     Float?

  status      MatchStatus @default(PROPOSED)

  proposedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?

  earnedAmount Float?
  offerMade    Boolean  @default(false)
  rating       Int?
  notes        String?

  @@unique([studentId, projectId])
  @@index([projectId, status])
  @@index([studentId, status])
  @@index([matchScore])
  @@index([notes])
}

enum MatchStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  ACTIVE
  COMPLETED
  DROPPED
}