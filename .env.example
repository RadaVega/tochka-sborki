# Database connection string for local development.
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated list of allowed frontend origins for CORS.
# Include local dev and your production domains (Amvera, Vercel).
CLIENT_URL=http://localhost:5173,https://your-domain.amvera.io,https://your-vercel-domain.example

# Optional: set in Vercel when the frontend should call an external API host.
# Leave empty on Amvera/local to use same-origin /api routes.
VITE_API_BASE_URL=

# SMTP settings for contact form notifications.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user@example.com
EMAIL_PASS=YOUR_SMTP_APP_PASSWORD
EMAIL_FROM="Точка Сборки <your-smtp-user@example.com>"
EMAIL_TO=notifications@example.com

# Local admin password placeholder. Use a strong secret in real environments.
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD